# Copy these values into Streamlit Community Cloud secrets.
# Do not commit a real secrets.toml file.

OPENAI_API_KEY = "replace-with-your-openai-api-key"
OPENAI_MODEL = "gpt-4.1-mini"
OPENAI_RESUME_MODEL = "gpt-4.1-mini"

# Keep embeddings off for low-cost demos unless you intentionally enable them.
ENABLE_OPENAI_EMBEDDINGS = "false"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
